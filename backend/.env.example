# 친구비 측정기 백엔드 설정 예시
# 실제 값은 .env 에 두고 커밋하지 않는다.

FC_TTL_SECONDS=1200

FC_MAX_IMAGES=10
FC_MIN_IMAGES=1
FC_MAX_IMAGE_BYTES=5242880
FC_MAX_TOTAL_BYTES=20971520
FC_MIN_IMAGE_SIDE=320

# 총 화소 수 상한. 파일 크기와는 별개다.
# 균일한 색으로 채운 PNG는 33바이트로도 30000x30000을 선언할 수 있다.
# 한 변이 아니라 총 화소를 보는 이유는 8000x8000 같은 조합을 놓치기 때문이다.
FC_MAX_IMAGE_PIXELS=40000000
FC_ALLOWED_MIME_TYPES=["image/png","image/jpeg","image/webp"]

FC_RATE_LIMIT_PER_MINUTE=5
FC_DAILY_ANALYSIS_LIMIT=10
FC_CONCURRENT_ANALYSIS_LIMIT=3
FC_POLL_RATE_LIMIT_PER_MINUTE=60
FC_POLL_AFTER_SECONDS=2

FC_TOTAL_TIMEOUT_SECONDS=180
FC_OCR_TIMEOUT_SECONDS=60
FC_LLM_TIMEOUT_SECONDS=45

FC_MAX_MESSAGES=120
FC_SWEEP_INTERVAL_SECONDS=60

# --- 교체 지점 ---
# 후보와 선정 근거는 mdfiles/AI-모델-선정-보고서.md 참조.
#
# 경고: 무료 티어라도 입력을 학습에 쓰는 곳은 쓰면 안 된다.
#       우리는 사용자 본인이 아니라 대화 상대방의 사적 메시지를 다룬다.
#       Gemini 무료 티어와 Mistral 무료 티어가 여기에 해당한다.
#
# 모델 제작사가 아니라 **추론 제공자**의 정책을 본다. qwen 은 Alibaba 가
# 만들었지만 Apache 2.0 오픈 웨이트이고 Groq 이 자사 하드웨어에서 돌린다.
# Alibaba 는 요청을 받지 않는다.

# stub | anthropic | groq | deepseek | together | openrouter
FC_LLM_PROVIDER=groq

# 2026-08-26 실측으로 확정. 후보 4개 중 순위 일치도 93%, 친밀도 편차 19.6.
# 근거는 AI-모델-선정-보고서.md 9장.
FC_LLM_MODEL=qwen/qwen3.8-27b

# console.groq.com/keys 에서 발급한다. gsk_ 로 시작한다.
# 발급 후 Settings -> Data Controls 에서 Global ZDR 을 켠다.
# 켜지 않으면 입출력이 30일간 저장된다.
FC_LLM_API_KEY=

# 추론 모델의 사고 분량. **비우면 400이 난다.**
# reasoning 이 출력 예산을 다 먹고 본문을 못 내놓기 때문이다.
# 허용값이 계열마다 다르다. qwen 은 none/default, gpt-oss 는 low/medium/high.
FC_LLM_REASONING_EFFORT=none

# 알려지지 않은 OpenAI 호환 엔드포인트를 쓸 때만 지정
FC_LLM_BASE_URL=
# anthropic 전용
FC_LLM_EFFORT=low

# stub | google_vision
FC_OCR_ENGINE=stub
FC_OCR_API_KEY=

# 배포 시 프론트 도메인. 비워두면 브라우저에서 호출되지 않는다.
# 와일드카드는 넣을 수 없다.
FC_CORS_ORIGINS=[]

FC_LOG_LEVEL=INFO
